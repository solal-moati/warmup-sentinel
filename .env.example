# Copy to .env (git-ignored). In CI, use GitHub secrets instead.
LEMLIST_API_KEY=
# Incoming webhook (Google Chat or Slack) for the morning capacity ping (optional)
CHAT_WEBHOOK=
# Extra domains to watch on the blocklists, comma-separated: your website,
# a tracking domain... (optional)
SITE_DOMAINS=
# Domains of your internal test leads, never paused by the guard (optional)
TEST_LEAD_DOMAINS=
# Recipient(s) of the lemlist alerts, comma-separated
ALERT_EMAIL=
