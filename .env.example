# Copy to .env (git-ignored). In CI, use GitHub secrets instead.
LEMLIST_API_KEY=
# Incoming webhook (Google Chat or Slack) for the morning capacity ping (optional)
CHAT_WEBHOOK=
# Extra domains to watch on the blocklists, comma-separated: your website,
# a tracking domain... (optional)
SITE_DOMAINS=
# Domains of your internal test leads, never paused by the guard (optional)
TEST_LEAD_DOMAINS=
# Recipient(s) of the lemlist alerts, comma-separated
ALERT_EMAIL=

# Operator rules (optional, defaults shown). These are our rules, not
# provider limits: adjust them to your setup.
# BOX_DAILY_CAP=50            # emails per mailbox per day, warmup included
# ACTIVE_MIN=84               # 7-day mean lemwarm score for a healthy mailbox
# RECOVERING_MIN=80           # one reading below this = resting for 7 days
# QUARANTINE_INBOX_BELOW=70   # mean inbox placement veto, overrides the score
# EMAILS_PER_LEAD=3.5         # emails a lead costs over its sequence (cruise figure)
# TARGET_NEW_LEADS=80         # daily target shown in the report
# PAUSE_CAP=10                # leads the guard may pause per run
