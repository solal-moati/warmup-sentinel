#!/bin/sh
# Git permanently records both addresses. Use a GitHub noreply identity.
for identity_kind in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
    identity_value=$(git var "$identity_kind") || exit 1
    case "$identity_value" in
        *'@users.noreply.github.com>'*) ;;
        *)
            printf '%s\n' 'Commit blocked: configure your GitHub noreply email (see CONTRIBUTING.md).' >&2
            exit 1
            ;;
    esac
done

# Scan the content actually staged for publication, with secrets redacted.
scanner_path=$(command -v gitleaks || git config --local --get sentinel.gitleaksPath || true)
if [ -z "$scanner_path" ] || [ ! -x "$scanner_path" ]; then
    printf '%s\n' 'Commit blocked: install Gitleaks or configure sentinel.gitleaksPath (see CONTRIBUTING.md).' >&2
    exit 1
fi
"$scanner_path" git --pre-commit --staged --redact=100 --no-banner || exit 1
